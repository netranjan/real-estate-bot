<div class="space-y-6 fade-in">
  <!-- Header -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <div class="flex justify-between items-start flex-wrap gap-4">
      <div>
        <h2 class="text-2xl font-bold text-slate-800"><%= property.property_name %></h2>
        <p class="text-sm text-slate-500">Visit Slots Management</p>
      </div>
      <a href="/admin/properties?clientId=<%= clientId %>" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm">← Back to Properties</a>
    </div>
  </div>

  <!-- Add Slot Form -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h3 class="text-lg font-semibold text-slate-800 mb-4">Add New Slot</h3>
    <form action="/admin/properties/<%= property.property_id %>/slots" method="POST" class="flex items-end gap-3">
      <input type="hidden" name="clientId" value="<%= clientId %>">
      <div class="flex-1">
        <label class="block text-sm font-medium text-slate-700 mb-1">Slot Name</label>
        <input type="text" name="option_name" required placeholder="e.g. Saturday 10 AM"
               class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 outline-none">
      </div>
      <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2.5 rounded-lg text-sm font-medium">
        Add Slot
      </button>
    </form>
  </div>

  <!-- Existing Slots -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200">
      <h3 class="text-lg font-semibold text-slate-800">Existing Slots</h3>
    </div>
    <% if (slots.length > 0) { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b">
          <tr>
            <th class="text-left px-6 py-3 font-semibold text-slate-600">Slot Name</th>
            <th class="text-left px-6 py-3 font-semibold text-slate-600">Status</th>
            <th class="text-right px-6 py-3 font-semibold text-slate-600">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% slots.forEach(slot => { %>
          <tr class="border-b hover:bg-slate-50">
            <td class="px-6 py-3 text-slate-800"><%= slot.option_name %></td>
            <td class="px-6 py-3">
              <span class="px-2 py-1 rounded text-xs font-medium <%= slot.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                <%= slot.active ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <td class="px-6 py-3 text-right">
              <div class="flex justify-end gap-2">
                <form action="/admin/properties/<%= property.property_id %>/slots/<%= slot.visit_option_id %>/toggle" method="POST" class="inline">
                  <input type="hidden" name="clientId" value="<%= clientId %>">
                  <button type="submit" class="text-xs px-3 py-1.5 border border-slate-300 rounded hover:bg-slate-100">
                    <%= slot.active ? 'Disable' : 'Enable' %>
                  </button>
                </form>
                <form action="/admin/properties/<%= property.property_id %>/slots/<%= slot.visit_option_id %>/delete" method="POST" class="inline"
                      onsubmit="return confirm('Delete this slot?')">
                  <input type="hidden" name="clientId" value="<%= clientId %>">
                  <button type="submit" class="text-xs px-3 py-1.5 border border-red-300 text-red-600 rounded hover:bg-red-50">Delete</button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-8 text-slate-400 text-sm">No slots created yet. Add your first slot above.</div>
    <% } %>
  </div>
</div>