<div class="space-y-6 fade-in">
  <!-- Header -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <div class="flex justify-between items-start flex-wrap gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-2xl font-bold text-slate-800">
            <%= client.business_name %>
          </h2>
          <% if (client.active) { %>
            <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-semibold">Active</span>
            <% } else { %>
              <span class="px-2 py-1 bg-red-100 text-red-700 rounded text-xs font-semibold">Inactive</span>
              <% } %>
        </div>
        <p class="text-sm text-slate-500">Client ID: <span class="font-mono text-xs">
            <%= client.client_id %>
          </span></p>
      </div>
      <div class="flex gap-2">
        <a href="/admin/clients/<%= client.client_id %>/edit?key=<%= req.query.key || '' %>"
          class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium">Edit</a>
        <a href="/admin/clients?key=<%= req.query.key || '' %>"
          class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm">Back</a>
      </div>
    </div>

    <!-- Workspace Quick Links -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-6">
      <a href="/admin/properties?key=<%= req.query.key || '' %>&clientId=<%= client.client_id %>"
        class="bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-4 transition">
        <p class="text-xs text-blue-600 uppercase font-semibold tracking-wider">Properties</p>
        <p class="text-2xl font-bold text-blue-900 mt-1">
          <%= stats.properties %>
        </p>
      </a>
      <a href="/admin/flows?key=<%= req.query.key || '' %>&clientId=<%= client.client_id %>"
        class="bg-purple-50 hover:bg-purple-100 border border-purple-200 rounded-lg p-4 transition">
        <p class="text-xs text-purple-600 uppercase font-semibold tracking-wider">Flows</p>
        <p class="text-2xl font-bold text-purple-900 mt-1">
          <%= stats.flows %>
        </p>
      </a>
      <a href="/admin/leads?key=<%= req.query.key || '' %>&clientId=<%= client.client_id %>"
        class="bg-green-50 hover:bg-green-100 border border-green-200 rounded-lg p-4 transition">
        <p class="text-xs text-green-600 uppercase font-semibold tracking-wider">Leads</p>
        <p class="text-2xl font-bold text-green-900 mt-1">
          <%= stats.leads %>
        </p>
      </a>
      <a href="/admin/visits?key=<%= req.query.key || '' %>&clientId=<%= client.client_id %>"
        class="bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded-lg p-4 transition">
        <p class="text-xs text-amber-600 uppercase font-semibold tracking-wider">Agents</p>
        <p class="text-2xl font-bold text-amber-900 mt-1">
          <%= stats.agents %>
        </p>
      </a>
    </div>
  </div>

  <!-- WhatsApp Flow Management -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-semibold text-slate-800">🤖 WhatsApp Flow</h3>
    </div>

    <% const clientFlows=(typeof allFlows !=='undefined' && allFlows) ? allFlows.filter(f=> f.client_id ==
      client.client_id) : []; %>
      <% if (clientFlows.length> 0) { %>
        <div class="space-y-3">
          <% clientFlows.forEach(flow=> { %>
            <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-200">
              <div>
                <p class="font-medium text-sm text-slate-800">
                  <%= flow.flow_name %>
                </p>
                <p class="text-xs text-slate-500">v<%= flow.flow_version %> • <%= flow.is_active ? 'Active' : 'Inactive'
                      %>
                </p>
              </div>
              <div class="flex gap-2">
                <a href="/admin/flows?clientId=<%= client.client_id %>"
                  class="text-xs px-3 py-1.5 bg-white border border-slate-300 rounded hover:bg-purple-50 transition">Edit
                  Flow</a>
              </div>
            </div>
            <% }) %>
        </div>
        <% } else { %>
          <div class="text-center py-6 text-slate-400">
            <p class="text-sm mb-3">No WhatsApp flow configured yet.</p>
            <a href="/admin/flows?clientId=<%= client.client_id %>"
              class="inline-block px-4 py-2 bg-purple-600 text-white rounded-lg text-sm hover:bg-purple-700 transition">
              + Create Flow
            </a>
          </div>
          <% } %>
  </div>

  <!-- Meta Configuration -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h3 class="text-lg font-semibold text-slate-800 mb-4">Meta Configuration</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <p class="text-xs text-slate-500 uppercase font-semibold">WABA ID</p>
        <p class="font-mono text-sm text-slate-700 mt-1">
          <%= client.meta_waba_id || 'Not set' %>
        </p>
      </div>
      <div>
        <p class="text-xs text-slate-500 uppercase font-semibold">Phone Number ID</p>
        <p class="font-mono text-sm text-slate-700 mt-1">
          <%= client.meta_phone_number_id || 'Not set' %>
        </p>
      </div>
      <div>
        <p class="text-xs text-slate-500 uppercase font-semibold">Access Token</p>
        <p class="font-mono text-sm text-slate-700 mt-1">
          <%= client.meta_access_token ? '••••••••' + client.meta_access_token.slice(-8) : 'Not set' %>
        </p>
      </div>
    </div>
  </div>

  <!-- Recent Leads -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">
      <h3 class="text-lg font-semibold text-slate-800">Recent Leads</h3>
      <a href="/admin/leads?key=<%= req.query.key || '' %>&clientId=<%= client.client_id %>"
        class="text-sm text-blue-600 hover:underline">View all</a>
    </div>
    <% if (recentLeads.length> 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 border-b">
            <tr>
              <th class="text-left px-6 py-3 font-semibold text-slate-600">Name</th>
              <th class="text-left px-6 py-3 font-semibold text-slate-600">Phone</th>
              <th class="text-left px-6 py-3 font-semibold text-slate-600">Stage</th>
              <th class="text-left px-6 py-3 font-semibold text-slate-600">Score</th>
              <th class="text-left px-6 py-3 font-semibold text-slate-600">Created</th>
            </tr>
          </thead>
          <tbody>
            <% recentLeads.forEach(lead=> { %>
              <tr class="border-b hover:bg-slate-50">
                <td class="px-6 py-3 font-medium text-slate-800">
                  <%= lead.name || 'Unknown' %>
                </td>
                <td class="px-6 py-3 font-mono text-xs text-slate-600">
                  <%= lead.whatsapp_number %>
                </td>
                <td class="px-6 py-3"><span class="px-2 py-1 bg-slate-100 text-slate-700 rounded text-xs">
                    <%= lead.pipeline_stage %>
                  </span></td>
                <td class="px-6 py-3">
                  <%= lead.ai_score || '-' %>
                </td>
                <td class="px-6 py-3 text-slate-500 text-xs">
                  <%= new Date(lead.created_at).toLocaleDateString('en-IN') %>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
        <div class="text-center py-8 text-slate-400 text-sm">No leads yet</div>
        <% } %>
  </div>

  <!-- Recent Visits & Callbacks -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">
        <h3 class="text-lg font-semibold text-slate-800">Recent Site Visits</h3>
        <a href="/admin/visits?key=<%= req.query.key || '' %>&clientId=<%= client.client_id %>"
          class="text-sm text-blue-600 hover:underline">View all</a>
      </div>
      <% if (recentVisits.length> 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b">
              <tr>
                <th class="text-left px-6 py-3 font-semibold text-slate-600">Lead</th>
                <th class="text-left px-6 py-3 font-semibold text-slate-600">Status</th>
                <th class="text-left px-6 py-3 font-semibold text-slate-600">Date</th>
              </tr>
            </thead>
            <tbody>
              <% recentVisits.forEach(v=> { %>
                <tr class="border-b hover:bg-slate-50">
                  <td class="px-6 py-3 text-slate-800">
                    <%= v.lead_name || v.whatsapp_number %>
                  </td>
                  <td class="px-6 py-3"><span class="px-2 py-1 bg-purple-100 text-purple-700 rounded text-xs">
                      <%= v.status %>
                    </span></td>
                  <td class="px-6 py-3 text-slate-500 text-xs">
                    <%= new Date(v.created_at).toLocaleDateString('en-IN') %>
                  </td>
                </tr>
                <% }) %>
            </tbody>
          </table>
        </div>
        <% } else { %>
          <div class="text-center py-8 text-slate-400 text-sm">No site visits yet</div>
          <% } %>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">
        <h3 class="text-lg font-semibold text-slate-800">Recent Callbacks</h3>
        <a href="/admin/visits?key=<%= req.query.key || '' %>&clientId=<%= client.client_id %>"
          class="text-sm text-blue-600 hover:underline">View all</a>
      </div>
      <% if (recentCallbacks.length> 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b">
              <tr>
                <th class="text-left px-6 py-3 font-semibold text-slate-600">Lead</th>
                <th class="text-left px-6 py-3 font-semibold text-slate-600">Status</th>
                <th class="text-left px-6 py-3 font-semibold text-slate-600">Date</th>
              </tr>
            </thead>
            <tbody>
              <% recentCallbacks.forEach(c=> { %>
                <tr class="border-b hover:bg-slate-50">
                  <td class="px-6 py-3 text-slate-800">
                    <%= c.lead_name || c.whatsapp_number %>
                  </td>
                  <td class="px-6 py-3"><span class="px-2 py-1 bg-amber-100 text-amber-700 rounded text-xs">
                      <%= c.status %>
                    </span></td>
                  <td class="px-6 py-3 text-slate-500 text-xs">
                    <%= new Date(c.created_at).toLocaleDateString('en-IN') %>
                  </td>
                </tr>
                <% }) %>
            </tbody>
          </table>
        </div>
        <% } else { %>
          <div class="text-center py-8 text-slate-400 text-sm">No callbacks yet</div>
          <% } %>
    </div>
  </div>
</div>