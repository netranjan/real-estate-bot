<div class="space-y-6">
  <!-- Client Context Banner -->
  <% if (typeof clientId !== 'undefined' && clientId) { %>
    <% const currentClient = (typeof allClients !== 'undefined') ? allClients.find(c => c.client_id == clientId) : null; %>
    <% if (currentClient) { %>
      <div class="bg-blue-50 border border-blue-200 rounded-xl px-6 py-4 flex items-center justify-between">
        <div>
          <p class="text-sm text-blue-800 font-medium">Managing: <span class="font-bold"><%= currentClient.business_name %></span></p>
          <p class="text-xs text-blue-600 mt-0.5">Client ID <%= currentClient.client_id %> • <%= currentClient.active ? 'Active' : 'Inactive' %></p>
        </div>
        <a href="/admin/clients/<%= clientId %>?key=<%= req.query.key || '' %>" class="text-sm text-blue-700 hover:text-blue-900 font-medium">View Client →</a>
      </div>
    <% } %>
  <% } else { %>
    <div class="bg-amber-50 border border-amber-200 rounded-xl px-6 py-4">
      <p class="text-sm text-amber-800 font-medium">⚠️ No client selected</p>
      <p class="text-xs text-amber-600 mt-1">Use the sidebar dropdown to select a client and manage their properties, flows, leads, and visits.</p>
    </div>
  <% } %>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-slate-500 font-medium">Total Leads</p>
          <p class="text-3xl font-bold text-slate-800 mt-1"><%= stats.leads %></p>
        </div>
        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center text-2xl">👥</div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-slate-500 font-medium">Active Properties</p>
          <p class="text-3xl font-bold text-slate-800 mt-1"><%= stats.properties %></p>
        </div>
        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center text-2xl">🏘️</div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-slate-500 font-medium">Pending Callbacks</p>
          <p class="text-3xl font-bold text-slate-800 mt-1"><%= stats.callbacks %></p>
        </div>
        <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center text-2xl">📞</div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-slate-500 font-medium">Today's Visits</p>
          <p class="text-3xl font-bold text-slate-800 mt-1"><%= stats.visits %></p>
        </div>
        <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center text-2xl">📅</div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h3 class="font-bold text-slate-800 mb-4 text-lg">Quick Actions</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <% const qKey = req.query.key || ''; const qClient = (typeof clientId !== 'undefined' && clientId) ? `&clientId=${clientId}` : ''; %>
      <a href="/admin/properties?key=<%= qKey %><%= qClient %>" class="p-4 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition">
        <p class="font-semibold text-blue-900">🏘️ Manage Properties</p>
        <p class="text-sm text-blue-700 mt-1">Add, edit, or deactivate properties for the selected client.</p>
      </a>
      <a href="/admin/flows?key=<%= qKey %><%= qClient %>" class="p-4 bg-purple-50 border border-purple-200 rounded-lg hover:bg-purple-100 transition">
        <p class="font-semibold text-purple-900">🔀 Edit Conversation Flow</p>
        <p class="text-sm text-purple-700 mt-1">Change bot messages, questions, and button paths.</p>
      </a>
      <a href="/admin/leads?key=<%= qKey %><%= qClient %>" class="p-4 bg-green-50 border border-green-200 rounded-lg hover:bg-green-100 transition">
        <p class="font-semibold text-green-900">👥 View Leads</p>
        <p class="text-sm text-green-700 mt-1">See who messaged, their answers, and current stage.</p>
      </a>
    </div>
  </div>

  <!-- How It Works -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h3 class="font-bold text-slate-800 mb-4 text-lg">How This System Works</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
      <div class="p-4 bg-slate-50 rounded-lg border border-slate-200">
        <div class="text-2xl mb-2">1️⃣</div>
        <p class="font-semibold text-slate-800">Clients</p>
        <p class="text-slate-600 mt-1">Each client is a tenant (business) with its own properties, flows, leads, and agents.</p>
      </div>
      <div class="p-4 bg-slate-50 rounded-lg border border-slate-200">
        <div class="text-2xl mb-2">2️⃣</div>
        <p class="font-semibold text-slate-800">Properties & Flows</p>
        <p class="text-slate-600 mt-1">Add projects and build the conversation step-by-step. Connect steps with "if user says X, go to Y".</p>
      </div>
      <div class="p-4 bg-slate-50 rounded-lg border border-slate-200">
        <div class="text-2xl mb-2">3️⃣</div>
        <p class="font-semibold text-slate-800">Leads & Visits</p>
        <p class="text-slate-600 mt-1">Track who is interested, manage site visits, and follow up on callback requests.</p>
      </div>
    </div>
  </div>
</div>