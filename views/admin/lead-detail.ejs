<div class="space-y-6 fade-in">
  <!-- Lead Header -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <div class="flex justify-between items-start flex-wrap gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-2xl font-bold text-slate-800"><%= lead.name || 'Unknown Lead' %></h2>
          <span class="px-2 py-1 bg-slate-100 text-slate-700 rounded text-xs font-semibold font-mono"><%= lead.whatsapp_number %></span>
          <span class="px-2 py-1 rounded text-xs font-semibold
            <%= lead.pipeline_stage === 'New Lead' ? 'bg-slate-100 text-slate-700' :
               lead.pipeline_stage === 'AI Qualified' ? 'bg-blue-100 text-blue-700' :
               lead.pipeline_stage === 'Site Visit Booked' ? 'bg-purple-100 text-purple-700' :
               lead.pipeline_stage === 'Callback Requested' ? 'bg-amber-100 text-amber-700' :
               'bg-red-100 text-red-700' %>">
            <%= lead.pipeline_stage %>
          </span>
        </div>
        <p class="text-sm text-slate-500">Lead ID: <span class="font-mono text-xs">#<%= lead.lead_id %></span> • Client: <span class="font-mono text-xs">#<%= lead.client_id %></span></p>
      </div>
      <div class="flex gap-2">
        <a href="/admin/leads?key=<%= req.query.key || '' %>&clientId=<%= lead.client_id %>" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm">← Back to Leads</a>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
      <div class="bg-slate-50 rounded-lg p-4 border border-slate-100">
        <p class="text-xs text-slate-500 uppercase font-semibold tracking-wider">AI Score</p>
        <p class="text-2xl font-bold text-slate-800 mt-1"><%= lead.ai_score || 0 %></p>
      </div>
      <div class="bg-slate-50 rounded-lg p-4 border border-slate-100">
        <p class="text-xs text-slate-500 uppercase font-semibold tracking-wider">Assigned Agent</p>
        <p class="text-2xl font-bold text-slate-800 mt-1"><%= lead.assigned_agent_id ? 'Agent #' + lead.assigned_agent_id : 'None' %></p>
      </div>
      <div class="bg-slate-50 rounded-lg p-4 border border-slate-100">
        <p class="text-xs text-slate-500 uppercase font-semibold tracking-wider">First Contact</p>
        <p class="text-sm font-bold text-slate-800 mt-1"><%= new Date(lead.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
      </div>
      <div class="bg-slate-50 rounded-lg p-4 border border-slate-100">
        <p class="text-xs text-slate-500 uppercase font-semibold tracking-wider">Last Updated</p>
        <p class="text-sm font-bold text-slate-800 mt-1"><%= new Date(lead.updated_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
      </div>
    </div>
  </div>

  <!-- Visual Timeline Map -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h3 class="text-lg font-semibold text-slate-800 mb-4 flex items-center gap-2">
      <span>🗺️</span> Lead Journey Timeline
    </h3>
    
    <% if (timeline && timeline.length > 0) { %>
    <div class="relative pl-8">
      <!-- Vertical line -->
      <div class="absolute left-3 top-0 bottom-0 w-0.5 bg-slate-200"></div>

      <!-- START node -->
      <div class="relative mb-6">
        <div class="absolute -left-8 top-0 w-6 h-6 rounded-full bg-green-500 border-4 border-white shadow flex items-center justify-center text-[10px] text-white font-bold">S</div>
        <div class="bg-green-50 border border-green-200 rounded-lg px-4 py-2 inline-block">
          <span class="text-xs font-semibold text-green-800">Lead Created</span>
          <span class="text-xs text-green-600 ml-2"><%= new Date(lead.created_at).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
        </div>
      </div>

      <% timeline.forEach((event, idx) => { 
        const eventMeta = {
          'NODE_TRANSITION': { icon: '🔀', color: 'blue', label: 'Bot Step' },
          'PIPELINE_CHANGE': { icon: '📊', color: 'purple', label: 'Stage Change' },
          'AGENT_ASSIGNED': { icon: '👤', color: 'indigo', label: 'Agent Assigned' },
          'SCORE_UPDATED': { icon: '⭐', color: 'amber', label: 'Score Update' },
          'PROPERTY_SELECTED': { icon: '🏠', color: 'green', label: 'Property Selected' }
        }[event.event_type] || { icon: '📌', color: 'slate', label: event.event_type };
        
        const details = event.details || {};
        let detailText = '';
        if (event.event_type === 'NODE_TRANSITION') {
          detailText = `Moved to step: ${event.node_name || 'Unknown'}`;
        } else if (event.event_type === 'PIPELINE_CHANGE') {
          detailText = `${details.from_stage || '?'} → ${details.to_stage || '?'}`;
        } else if (event.event_type === 'AGENT_ASSIGNED') {
          detailText = `Assigned to agent #${details.to_agent || '?'}`;
        } else if (event.event_type === 'SCORE_UPDATED') {
          detailText = `Score: ${details.old_score || 0} → ${details.new_score || 0}`;
        } else if (event.event_type === 'PROPERTY_SELECTED') {
          detailText = `Property #${details.new_property_id || '?'} selected${details.old_property_id ? ' (replaced #' + details.old_property_id + ')' : ''}`;
        }
      %>
        <div class="relative mb-6">
          <div class="absolute -left-8 top-0 w-6 h-6 rounded-full bg-<%= eventMeta.color %>-500 border-4 border-white shadow flex items-center justify-center text-[10px] text-white font-bold">
            <%= idx + 1 %>
          </div>
          
          <div class="bg-white rounded-lg border border-slate-200 p-4 hover:shadow-sm transition">
            <div class="flex justify-between items-start">
              <div class="flex items-center gap-2">
                <span class="text-lg"><%= eventMeta.icon %></span>
                <span class="text-xs font-semibold uppercase tracking-wider text-<%= eventMeta.color %>-700 bg-<%= eventMeta.color %>-100 px-2 py-0.5 rounded"><%= eventMeta.label %></span>
                <% if (event.node_name) { %>
                  <span class="text-xs text-slate-500">@ <%= event.node_name %></span>
                <% } %>
              </div>
              <span class="text-xs text-slate-400"><%= new Date(event.created_at).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
            </div>
            
            <% if (detailText) { %>
              <p class="text-sm text-slate-700 mt-2 font-medium"><%= detailText %></p>
            <% } %>
            
            <% if (Object.keys(details).length > 0 && !detailText) { %>
              <div class="mt-2 p-2 bg-slate-50 rounded text-xs text-slate-600 font-mono">
                <%= JSON.stringify(details) %>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>

      <!-- Current State -->
      <div class="relative">
        <div class="absolute -left-8 top-0 w-6 h-6 rounded-full bg-slate-800 border-4 border-white shadow flex items-center justify-center text-[10px] text-white font-bold">●</div>
        <div class="bg-slate-800 text-white rounded-lg px-4 py-2 inline-block">
          <span class="text-xs font-semibold">Current State: <%= lead.pipeline_stage %></span>
          <span class="text-xs text-slate-300 ml-2">Node: <%= lead.current_node_id ? '#' + lead.current_node_id : 'None' %></span>
        </div>
      </div>
    </div>
    <% } else { %>
      <div class="text-center py-12">
        <div class="text-3xl mb-2">🗺️</div>
        <p class="text-slate-500 text-sm">No timeline events yet</p>
        <p class="text-xs text-slate-400 mt-1">Events will appear as the lead interacts with the bot</p>
      </div>
    <% } %>
  </div>

  <!-- Lead Answers -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200">
      <h3 class="text-lg font-semibold text-slate-800">Collected Answers</h3>
    </div>
    <% if (answers && answers.length > 0) { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b">
          <tr>
            <th class="text-left px-6 py-3 font-semibold text-slate-600">Field</th>
            <th class="text-left px-6 py-3 font-semibold text-slate-600">Value</th>
          </tr>
        </thead>
        <tbody>
          <% answers.forEach(a => { %>
          <tr class="border-b hover:bg-slate-50">
            <td class="px-6 py-3 font-mono text-xs text-slate-600"><%= a.field_name %></td>
            <td class="px-6 py-3 text-slate-800"><%= a.field_value %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-8 text-slate-400 text-sm">No answers collected yet</div>
    <% } %>
  </div>

  <!-- Raw History Log -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200">
      <h3 class="text-lg font-semibold text-slate-800">Raw Event Log</h3>
    </div>
    <% if (history && history.length > 0) { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b">
          <tr>
            <th class="text-left px-6 py-3 font-semibold text-slate-600">Time</th>
            <th class="text-left px-6 py-3 font-semibold text-slate-600">Event</th>
            <th class="text-left px-6 py-3 font-semibold text-slate-600">Details</th>
          </tr>
        </thead>
        <tbody>
          <% history.forEach(h => { %>
          <tr class="border-b hover:bg-slate-50">
            <td class="px-6 py-3 text-slate-500 text-xs whitespace-nowrap"><%= new Date(h.created_at).toLocaleString('en-IN') %></td>
            <td class="px-6 py-3">
              <span class="px-2 py-1 bg-slate-100 text-slate-700 rounded text-xs font-medium"><%= h.event_type %></span>
            </td>
            <td class="px-6 py-3 text-slate-600 text-xs font-mono"><%= JSON.stringify(h.details) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-8 text-slate-400 text-sm">No history events yet</div>
    <% } %>
  </div>
</div>