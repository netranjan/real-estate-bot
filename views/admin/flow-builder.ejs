                  <!-- Configuration -->
                  <div class="filter-block bg-white border border-slate-200 rounded-lg p-3">
                    <label class="flex items-center gap-2 cursor-pointer">
                      <input type="checkbox" id="f-config" class="w-4 h-4 text-purple-600 rounded">
                      <span class="text-sm font-medium text-slate-700">🏠 Configuration</span>
                    </label>
                    <div class="mt-2 ml-6 flex flex-wrap gap-2">
                      <label class="text-xs bg-slate-100 px-2 py-1 rounded cursor-pointer"><input type="checkbox" class="f-config-opt mr-1" value="1BHK">1BHK</label>
                      <label class="text-xs bg-slate-100 px-2 py-1 rounded cursor-pointer"><input type="checkbox" class="f-config-opt mr-1" value="2BHK">2BHK</label>
                      <label class="text-xs bg-slate-100 px-2 py-1 rounded cursor-pointer"><input type="checkbox" class="f-config-opt mr-1" value="3BHK">3BHK</label>
                      <label class="text-xs bg-slate-100 px-2 py-1 rounded cursor-pointer"><input type="checkbox" class="f-config-opt mr-1" value="4BHK">4BHK</label>
                      <input type="text" id="f-config-custom" placeholder="Or {{configuration}}" class="w-full mt-1 px-2 py-1.5 border border-slate-300 rounded text-xs">
                    </div>
                  </div>
                  <!-- Possession -->
                  <div class="filter-block bg-white border border-slate-200 rounded-lg p-3">
                    <label class="flex items-center gap-2 cursor-pointer">
                      <input type="checkbox" id="f-possession" class="w-4 h-4 text-purple-600 rounded">
                      <span class="text-sm font-medium text-slate-700">📅 Possession</span>
                    </label>
                    <div class="mt-2 ml-6 flex gap-2">
                      <select id="f-possession-op" class="px-2 py-1.5 border border-slate-300 rounded text-xs bg-white">
                        <option value="eq">Is</option>
                        <option value="gte">Year ≥</option>
                      </select>
                      <input type="text" id="f-possession-val" placeholder="ready / 2026 / {{timeline}}" class="flex-1 px-2 py-1.5 border border-slate-300 rounded text-xs">
                    </div>
                  </div>
                  <!-- Property Name -->
                  <div class="filter-block bg-white border border-slate-200 rounded-lg p-3">
                    <label class="flex items-center gap-2 cursor-pointer">
                      <input type="checkbox" id="f-name" class="w-4 h-4 text-purple-600 rounded">
                      <span class="text-sm font-medium text-slate-700">🏢 Property Name</span>
                    </label>
                    <div class="mt-2 ml-6">
                      <input type="text" id="f-name-val" placeholder="Contains (e.g. Godrej) or {{project}}" class="w-full px-2 py-1.5 border border-slate-300 rounded text-xs">
                    </div>
                  </div>
                  <p class="text-xs text-slate-400">The bot shows only properties that match <b>ALL</b> checked rules. Use <code class="bg-slate-100 px-1 rounded">{{field_name}}</code> to use saved lead answers.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="flex justify-between mt-4">
          <button onclick="wzGoTo(1)" class="px-4 py-2 text-sm text-slate-600 hover:bg-slate-100 rounded-lg">← Back</button>
          <button onclick="wzGoTo(3)" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg text-sm font-medium shadow-sm">Next →</button>
        </div>
      </div>

      <div id="wz-step-3" class="hidden space-y-4">
        <label class="block text-sm font-semibold text-slate-700">3. Name this step <span class="text-slate-400 font-normal">(for your reference only)</span></label>
        <input type="text" id="wz-step-name" placeholder="e.g. Ask Budget" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-purple-500 outline-none text-sm">
        <p class="text-xs text-slate-400">Tip: Use descriptive names like "Ask Budget" or "Show Godrej Park" so you can easily identify steps when connecting them.</p>
        <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
          <p class="text-xs font-semibold text-slate-600 mb-2">Summary</p>
          <div class="text-sm text-slate-700 space-y-1">
            <p>Type: <span id="wz-summary-type" class="font-medium">Question</span></p>
            <p>Message: <span id="wz-summary-msg" class="font-medium text-slate-500">-</span></p>
            <p>Options: <span id="wz-summary-opts" class="font-medium text-slate-500">-</span></p>
          </div>
        </div>
        <div class="flex justify-between mt-4">
          <button onclick="wzGoTo(2)" class="px-4 py-2 text-sm text-slate-600 hover:bg-slate-100 rounded-lg">← Back</button>
          <button onclick="submitWizard()" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg text-sm font-medium shadow-sm">Save Step</button>
        </div>
      </div>
    </div>

    <!-- Direct Editor Mode -->
    <div id="direct-mode" class="hidden flex-1 p-6 space-y-5 overflow-auto">
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-3">
        <p class="text-xs font-semibold text-blue-800">💡 Power Editor</p>
        <p class="text-xs text-blue-700 mt-1">Full control without writing JSON. Pick a type, fill the form, done.</p>
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-2">Step Name <span class="text-slate-400 font-normal">(your reference)</span></label>
        <input type="text" id="de-name" placeholder="e.g. Ask Budget" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-purple-500 outline-none text-sm">
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-2">What does this step do?</label>
        <select id="de-type" onchange="deOnTypeChange()" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-purple-500 outline-none text-sm bg-white">
          <option value="send_message">📝 Send a text message only</option>
          <option value="collect_input">❓ Ask a question with button choices</option>
          <option value="show_list">🏠 Show a list of properties</option>
          <option value="property_welcome">🏢 Show project welcome + action buttons</option>
          <option value="send_document">📄 Send a PDF brochure</option>
          <option value="book_appointment">📅 Book a site visit</option>
          <option value="request_callback">📞 Request agent callback</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-2">Bot Message</label>
        <textarea id="de-message" rows="3" placeholder="Type what the bot should say..." class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-purple-500 outline-none text-sm"></textarea>
        <div class="mt-3 bg-[#e5ddd5] rounded-2xl p-4 max-w-sm mx-auto border border-slate-200">
          <div class="bg-white rounded-lg rounded-tl-none px-3 py-2 shadow-sm max-w-[85%]">
            <p class="text-sm text-slate-800" id="de-preview-msg">Type above to see preview...</p>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-2 max-w-[85%]" id="de-preview-opts"></div>
        </div>
      </div>
      <div id="de-options-builder" class="hidden space-y-3">
        <div class="flex items-center justify-between">
          <label class="block text-sm font-semibold text-slate-700">Button Choices <span class="text-slate-400 font-normal">(max 3 for WhatsApp buttons)</span></label>
          <button onclick="deAddOption()" class="text-xs bg-purple-100 hover:bg-purple-200 text-purple-700 px-2 py-1 rounded font-medium">+ Add Choice</button>
        </div>
        <div id="de-options-list" class="space-y-2"></div>
        <p class="text-xs text-slate-400">Each choice becomes a button. When tapped, the bot saves the value and goes to the next step.</p>
      </div>
      <div id="de-buttons-builder" class="hidden space-y-3">
        <div class="flex items-center justify-between">
          <label class="block text-sm font-semibold text-slate-700">Action Buttons</label>
          <button onclick="deAddButton()" class="text-xs bg-orange-100 hover:bg-orange-200 text-orange-700 px-2 py-1 rounded font-medium">+ Add Button</button>
        </div>
        <div id="de-buttons-list" class="space-y-2"></div>
      </div>
      <div id="de-document-box" class="hidden">
        <label class="block text-sm font-semibold text-slate-700 mb-2">PDF URL</label>
        <input type="url" id="de-document-url" placeholder="https://cdn.example.com/brochure.pdf" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-purple-500 outline-none text-sm">
      </div>
      <div id="de-list-box" class="hidden">
        <label class="flex items-center gap-2 p-3 bg-green-50 border border-green-200 rounded-lg cursor-pointer">
          <input type="checkbox" id="de-dynamic-list" checked class="w-4 h-4 text-green-600 rounded">
          <div>
            <p class="text-sm font-medium text-green-800">Show properties from database</p>
            <p class="text-xs text-green-600">Automatically pulls active properties for this client</p>
          </div>
        </label>
      </div>
      <div class="flex items-center gap-3 pt-4 border-t border-slate-200">
        <button onclick="deLoadExample()" class="text-xs text-purple-600 hover:text-purple-800 font-medium px-3 py-2 bg-purple-50 hover:bg-purple-100 rounded-lg">🎲 Load Example</button>
        <span class="text-xs text-slate-400">Fills realistic sample data for this step type</span>
      </div>
      <div class="flex justify-end">
        <button onclick="submitDirect()" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg text-sm font-medium shadow-sm">Save Step</button>
      </div>
    </div>

    <form id="modal-form" action="/admin/flows/steps?key=<%= req.query.key || '' %>&clientId=<%= clientId %>" method="POST" class="hidden">
      <input type="hidden" name="key" value="<%= req.query.key || '' %>">
      <input type="hidden" name="clientId" value="<%= clientId %>">
      <input type="hidden" name="step_type" id="form-step-type">
      <input type="hidden" name="step_name" id="form-step-name">
      <textarea name="message_text" id="form-message"></textarea>
      <textarea name="options" id="form-options"></textarea>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>

<% if (activeFlow) { %>
const sortable = Sortable.create(document.getElementById('sortable-steps'), {
  handle: '.handle', animation: 150,
  onEnd: async function (evt) {
    const nodeIds = Array.from(document.querySelectorAll('.step-card')).map(el => el.dataset.nodeId);
    try {
      await fetch('/admin/flows/reorder?key=<%= req.query.key || '' %>&clientId=<%= clientId %>', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ flowId: <%= activeFlow.flow_id %>, nodeIds })
      });
      window.location.reload();
    } catch (e) { alert('Failed to save order'); }
  }
});
<% } %>

function toggleQuickConnect(nodeId) {
  const el = document.getElementById('qc-' + nodeId);
  el.classList.toggle('hidden');
  if (!el.classList.contains('hidden')) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function toggleActionField(select, nodeId) {
  const box = document.getElementById('af-box-' + nodeId);
  const field = document.getElementById('af-' + nodeId);
  const selectEl = document.getElementById('af-select-' + nodeId);
  if (select.value === 'save_answer' || select.value === 'score_lead') {
    box.classList.remove('hidden');
    if (select.value === 'save_answer') {
      selectEl.classList.remove('hidden'); field.classList.add('hidden'); field.value = '';
    } else {
      selectEl.classList.add('hidden'); field.classList.remove('hidden');
      field.placeholder = 'Score number (e.g. 10)'; field.name = 'action_field';
    }
  } else { box.classList.add('hidden'); field.value = ''; }
}

function onFieldSelectChange(select, nodeId) {
  const customInput = document.getElementById('af-' + nodeId);
  if (select.value === '__custom__') {
    customInput.classList.remove('hidden'); customInput.placeholder = 'Enter custom field name (no spaces)'; customInput.focus();
  } else if (select.value) { customInput.classList.add('hidden'); customInput.value = select.value; }
  else { customInput.classList.add('hidden'); customInput.value = ''; }
}

let currentMode = 'wizard', wzType = 'question', editingNodeId = null;

function openAddWizard() {
  editingNodeId = null; currentMode = 'wizard';
  document.getElementById('modal-title').textContent = 'Add Step';
  document.getElementById('mode-toggle').textContent = 'Switch to Direct Editor';
  resetWizard(); showMode('wizard');
  document.getElementById('step-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function openEditWizard(nodeId) {
  editingNodeId = nodeId;
  const card = document.querySelector(`.step-card[data-node-id="${nodeId}"]`);
  if (!card) return;
  const name = card.querySelector('.font-medium.text-slate-700')?.textContent?.trim() || '';
  const msg = card.querySelector('.whitespace-pre-wrap')?.textContent?.trim() || '';
  const optEls = card.querySelectorAll('.rounded-lg.text-xs.text-slate-700.shadow-sm');
  const opts = Array.from(optEls).map(el => el.textContent.trim()).join('\n');
  const label = card.querySelector('.uppercase')?.textContent?.trim();
  const reverseMap = { 'Question': 'question', 'Message': 'message', 'Property List': 'property_list', 'Welcome': 'property_welcome', 'Brochure': 'brochure', 'Book Visit': 'book_visit', 'Callback': 'callback' };
  const code = reverseMap[label] || 'question';
  const deTypeMap = { 'question': 'collect_input', 'message': 'send_message', 'property_list': 'show_list', 'property_welcome': 'property_welcome', 'brochure': 'send_document', 'book_visit': 'book_appointment', 'callback': 'request_callback' };
  
  const savedFilterMode = card.dataset.filterMode || '';
  const savedFilterConditions = JSON.parse(decodeURIComponent(card.dataset.filterConditions || '[]'));

  document.getElementById('modal-title').textContent = 'Edit Step';
  resetWizard(); wzSelectType(code);
  document.getElementById('wz-step-name').value = name;
  document.getElementById('wz-message').value = msg;
  document.getElementById('wz-options').value = opts;
  
  if (code === 'property_list') {
    if (savedFilterMode === 'filtered') {
      document.getElementById('wz-mode-filtered').checked = true;
    } else {
      document.getElementById('wz-mode-all').checked = true;
    }
    toggleFilterBuilder();
    restoreFilterConditions(savedFilterConditions);
  }
  
  updateWzPreview();

  document.getElementById('de-name').value = name;
  document.getElementById('de-type').value = deTypeMap[code] || 'send_message';
  document.getElementById('de-message').value = msg;
  document.getElementById('de-dynamic-list').checked = true;
  document.getElementById('de-options-list').innerHTML = '';
  document.getElementById('de-buttons-list').innerHTML = '';
  const optTexts = Array.from(optEls).map(el => el.textContent.trim()).filter(t => t);
  if (code === 'question') optTexts.forEach(text => deAddOption(text, ''));
  else if (code === 'property_welcome') optTexts.forEach(text => deAddButton(text, ''));
  deOnTypeChange(); deUpdatePreview();
  showMode('wizard');
  document.getElementById('step-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function closeModal() {
  document.getElementById('step-modal').classList.add('hidden');
  document.body.style.overflow = '';
}
function toggleMode() {
  currentMode = currentMode === 'wizard' ? 'direct' : 'wizard';
  document.getElementById('mode-toggle').textContent = currentMode === 'wizard' ? 'Switch to Direct Editor' : 'Switch to Wizard';
  showMode(currentMode);
}
function showMode(mode) {
  document.getElementById('wizard-mode').classList.toggle('hidden', mode !== 'wizard');
  document.getElementById('direct-mode').classList.toggle('hidden', mode !== 'direct');
}

function resetWizard() {
  wzType = 'question';
  document.querySelectorAll('.wz-type-card').forEach(c => {
    c.classList.remove('border-purple-500', 'bg-purple-50', 'ring-2', 'ring-purple-200');
    c.classList.add('border-slate-200');
  });
  document.getElementById('wz-step-1').classList.remove('hidden');
  document.getElementById('wz-step-2').classList.add('hidden');
  document.getElementById('wz-step-3').classList.add('hidden');
  document.getElementById('wz-message').value = '';
  document.getElementById('wz-message').dataset.autofilled = 'true';
  document.getElementById('wz-options').value = '';
  document.getElementById('wz-step-name').value = '';
  document.getElementById('wz-mode-all').checked = true;
  document.getElementById('wz-filter-builder').classList.add('hidden');
  restoreFilterConditions([]);
  updateWzPreview();
}

function wzSelectType(code) {
  wzType = code;
  document.querySelectorAll('.wz-type-card').forEach(c => {
    c.classList.remove('border-purple-500', 'bg-purple-50', 'ring-2', 'ring-purple-200');
    c.classList.add('border-slate-200');
  });
  const selected = document.querySelector(`.wz-type-card[data-wz-type="${code}"]`);
  if (selected) { selected.classList.remove('border-slate-200'); selected.classList.add('border-purple-500', 'bg-purple-50', 'ring-2', 'ring-purple-200'); }
  const hints = { 'question': 'Ask a question with button options', 'message': 'Just send text, no reply needed', 'property_list': 'Show projects from database', 'property_welcome': 'Show project details + action buttons', 'brochure': 'Send a PDF document', 'book_visit': 'Schedule a site visit', 'callback': 'Agent calls back' };
  document.getElementById('wz-type-hint').textContent = hints[code] || '';
  const optBox = document.getElementById('wz-options-box');
  const listModeBox = document.getElementById('wz-list-mode-box');
  if (code === 'question' || code === 'property_welcome') {
    optBox.classList.remove('hidden');
    listModeBox.classList.add('hidden');
  } else if (code === 'property_list') {
    optBox.classList.add('hidden');
    listModeBox.classList.remove('hidden');
  } else {
    optBox.classList.add('hidden');
    listModeBox.classList.add('hidden');
  }
  const examples = { 'question': 'What is your budget range?', 'message': 'Thanks for your interest! Here is what we offer.', 'property_list': 'Here are projects matching your requirements:', 'property_welcome': 'Welcome to our project! What would you like to do?', 'brochure': 'Here is the project brochure for your reference.', 'book_visit': 'Would you like to book a site visit?', 'callback': 'Our agent will call you back shortly.' };
  const msgInput = document.getElementById('wz-message');
  if (!msgInput.value || msgInput.dataset.autofilled === 'true') { msgInput.value = examples[code] || ''; msgInput.dataset.autofilled = 'true'; updateWzPreview(); }
}

function wzGoTo(step) {
  document.getElementById('wz-step-1').classList.add('hidden');
  document.getElementById('wz-step-2').classList.add('hidden');
  document.getElementById('wz-step-3').classList.add('hidden');
  document.getElementById('wz-step-' + step).classList.remove('hidden');
  if (step === 3) {
    document.getElementById('wz-summary-type').textContent = wzType;
    document.getElementById('wz-summary-msg').textContent = document.getElementById('wz-message').value || '-';
    let optsText = '-';
    if (wzType === 'property_list') {
      const mode = document.querySelector('input[name="wz-list-mode"]:checked')?.value || 'all';
      optsText = mode === 'filtered' ? 'Filtered list with rules' : 'Show all properties';
    } else {
      optsText = document.getElementById('wz-options').value.split('\n').filter(l => l.trim()).join(', ') || '-';
    }
    document.getElementById('wz-summary-opts').textContent = optsText;
  }
}

function updateWzPreview() {
  const msg = document.getElementById('wz-message').value;
  document.getElementById('wz-preview-msg').textContent = msg || 'Type above to see preview...';
  const opts = (document.getElementById('wz-options').value || '').split('\n').map(l => l.trim()).filter(l => l);
  const container = document.getElementById('wz-preview-opts');
  container.innerHTML = '';
  if ((wzType === 'question' || wzType === 'property_welcome') && opts.length > 0) {
    opts.forEach(opt => { const btn = document.createElement('span'); btn.className = 'px-3 py-1 bg-white border border-slate-200 rounded text-xs text-slate-700 shadow-sm'; btn.textContent = opt; container.appendChild(btn); });
  }
}
document.getElementById('wz-message').addEventListener('input', function () { this.dataset.autofilled = 'false'; updateWzPreview(); });
document.getElementById('wz-options').addEventListener('input', updateWzPreview);

function submitWizard() {
  document.getElementById('form-step-type').value = wzType;
  document.getElementById('form-step-name').value = document.getElementById('wz-step-name').value || 'Untitled Step';
  document.getElementById('form-message').value = document.getElementById('wz-message').value;
  let opts = document.getElementById('wz-options').value;

  if (wzType === 'property_list') {
    const mode = document.querySelector('input[name="wz-list-mode"]:checked')?.value || 'all';
    const conditions = collectFilterConditions();
    opts = JSON.stringify({ mode, conditions });
  }
  document.getElementById('form-options').value = opts;
  if (editingNodeId) {
    document.getElementById('modal-form').action = '/admin/flows/steps/' + editingNodeId + '/update?key=<%= req.query.key || '' %>&clientId=<%= clientId %>';
  } else {
    document.getElementById('modal-form').action = '/admin/flows/steps?key=<%= req.query.key || '' %>&clientId=<%= clientId %>';
  }
  document.getElementById('modal-form').submit();
}

function deOnTypeChange() {
  const type = document.getElementById('de-type').value;
  document.getElementById('de-options-builder').classList.toggle('hidden', type !== 'collect_input');
  document.getElementById('de-buttons-builder').classList.toggle('hidden', type !== 'property_welcome');
  document.getElementById('de-document-box').classList.toggle('hidden', type !== 'send_document');
  document.getElementById('de-list-box').classList.toggle('hidden', type !== 'show_list');
  deUpdatePreview();
}
function deAddOption(label, value) {
  const div = document.createElement('div'); div.className = 'flex gap-2 items-center de-opt-row';
  div.innerHTML = `<input type="text" placeholder="Button label (user sees)" value="${label || ''}" class="de-opt-label flex-1 px-3 py-2 border border-slate-300 rounded-lg text-sm"><input type="text" placeholder="Value (saved)" value="${value || ''}" class="de-opt-value w-32 px-3 py-2 border border-slate-300 rounded-lg text-sm font-mono text-xs"><button onclick="this.parentElement.remove(); deUpdatePreview();" class="text-slate-400 hover:text-red-500 px-1">✕</button>`;
  document.getElementById('de-options-list').appendChild(div); deUpdatePreview();
}
function deAddButton(title, id) {
  const div = document.createElement('div'); div.className = 'flex gap-2 items-center de-btn-row';
  div.innerHTML = `<input type="text" placeholder="Button title" value="${title || ''}" class="de-btn-title flex-1 px-3 py-2 border border-slate-300 rounded-lg text-sm"><input type="text" placeholder="ID (no spaces)" value="${id || ''}" class="de-btn-id w-32 px-3 py-2 border border-slate-300 rounded-lg text-sm font-mono text-xs"><button onclick="this.parentElement.remove(); deUpdatePreview();" class="text-slate-400 hover:text-red-500 px-1">✕</button>`;
  document.getElementById('de-buttons-list').appendChild(div); deUpdatePreview();
}
function deUpdatePreview() {
  const msg = document.getElementById('de-message').value;
  document.getElementById('de-preview-msg').textContent = msg || 'Type above to see preview...';
  const container = document.getElementById('de-preview-opts'); container.innerHTML = '';
  const type = document.getElementById('de-type').value;
  if (type === 'collect_input') {
    document.querySelectorAll('.de-opt-row').forEach(row => { const label = row.querySelector('.de-opt-label').value; if (label) { const btn = document.createElement('span'); btn.className = 'px-3 py-1 bg-white border border-slate-200 rounded text-xs text-slate-700 shadow-sm'; btn.textContent = label; container.appendChild(btn); } });
  } else if (type === 'property_welcome') {
    document.querySelectorAll('.de-btn-row').forEach(row => { const title = row.querySelector('.de-btn-title').value; if (title) { const btn = document.createElement('span'); btn.className = 'px-3 py-1 bg-white border border-slate-200 rounded text-xs text-slate-700 shadow-sm'; btn.textContent = title; container.appendChild(btn); } });
  }
}
document.getElementById('de-message').addEventListener('input', deUpdatePreview);

function deLoadExample() {
  const type = document.getElementById('de-type').value;
  const examples = {
    'send_message': { name: 'Thanks Message', msg: 'Thank you for your interest! Our team will get back to you shortly.', config: {} },
    'collect_input': { name: 'Ask Budget', msg: 'What is your approximate budget range?', options: [{ label: 'Under ₹50 Lakhs', value: 'under_50l' }, { label: '₹50L - ₹1 Crore', value: '50l_to_1cr' }, { label: 'Above ₹1 Crore', value: 'above_1cr' }] },
    'show_list': { name: 'Show Projects', msg: 'Here are projects matching your requirements. Tap one to view details:', dynamic: true },
    'property_welcome': { name: 'Godrej Welcome', msg: 'Welcome to Godrej Park! 🏡\n\nPremium 2 & 3 BHK homes starting at ₹75L.\n\nWhat would you like to do next?', buttons: [{ title: '📅 Book Site Visit', id: 'BOOK_VISIT' }, { title: '📄 Get Brochure', id: 'BROCHURE' }, { title: '📞 Request Callback', id: 'CALLBACK' }] },
    'send_document': { name: 'Send Brochure', msg: 'Here is the project brochure for your reference.', docUrl: 'https://cdn.example.com/godrej-park-brochure.pdf' },
    'book_appointment': { name: 'Book Visit', msg: 'Would you like to schedule a site visit? Pick a convenient date below.' },
    'request_callback': { name: 'Request Callback', msg: 'Our sales advisor will call you back within 30 minutes.\n\nPlease confirm your phone number is correct.' }
  };
  const ex = examples[type]; if (!ex) return;
  document.getElementById('de-name').value = ex.name;
  document.getElementById('de-message').value = ex.msg;
  document.getElementById('de-options-list').innerHTML = '';
  document.getElementById('de-buttons-list').innerHTML = '';
  if (ex.options) ex.options.forEach(o => deAddOption(o.label, o.value));
  if (ex.buttons) ex.buttons.forEach(b => deAddButton(b.title, b.id));
  if (ex.docUrl) document.getElementById('de-document-url').value = ex.docUrl;
  if (ex.dynamic !== undefined) document.getElementById('de-dynamic-list').checked = ex.dynamic;
  deUpdatePreview();
}

function submitDirect() {
  const name = document.getElementById('de-name').value || 'Untitled Step';
  const type = document.getElementById('de-type').value;
  const msg = document.getElementById('de-message').value;
  const typeMap = { 'send_message': 'message', 'collect_input': 'question', 'show_list': 'property_list', 'property_welcome': 'property_welcome', 'send_document': 'brochure', 'book_appointment': 'book_visit', 'request_callback': 'callback' };
  let opts = '';
  if (type === 'collect_input') {
    const lines = [];
    document.querySelectorAll('.de-opt-row').forEach(row => { const label = row.querySelector('.de-opt-label').value.trim(); if (label) lines.push(label); });
    opts = lines.join('\n');
  } else if (type === 'property_welcome') {
    const lines = [];
    document.querySelectorAll('.de-btn-row').forEach(row => { const title = row.querySelector('.de-btn-title').value.trim(); if (title) lines.push(title); });
    opts = lines.join('\n');
  } else if (type === 'show_list') {
    const isDynamic = document.getElementById('de-dynamic-list').checked;
    opts = JSON.stringify({ mode: isDynamic ? 'all' : 'manual', conditions: [] });
  }
  document.getElementById('form-step-type').value = typeMap[type] || 'message';
  document.getElementById('form-step-name').value = name;
  document.getElementById('form-message').value = msg;
  document.getElementById('form-options').value = opts;
  const form = document.getElementById('modal-form');
  if (editingNodeId) {
    form.action = '/admin/flows/steps/' + editingNodeId + '/update?key=<%= req.query.key || '' %>&clientId=<%= clientId %>';
  } else {
    form.action = '/admin/flows/steps?key=<%= req.query.key || '' %>&clientId=<%= clientId %>';
  }
  form.submit();
}

// ── Simplified Filter Builder ──
function toggleFilterBuilder() {
  const isFiltered = document.getElementById('wz-mode-filtered').checked;
  document.getElementById('wz-filter-builder').classList.toggle('hidden', !isFiltered);
}

function collectFilterConditions() {
  const conditions = [];
  if (document.getElementById('f-budget').checked) {
    const op = document.getElementById('f-budget-op').value;
    const val = document.getElementById('f-budget-val').value.trim();
    if (val) conditions.push({ field: 'budget_range', operator: op, value: val });
  }
  if (document.getElementById('f-config').checked) {
    const checked = Array.from(document.querySelectorAll('.f-config-opt:checked')).map(cb => cb.value);
    const custom = document.getElementById('f-config-custom').value.trim();
    const val = checked.length ? checked.join(',') : custom;
    if (val) conditions.push({ field: 'configuration', operator: checked.length > 1 ? 'in' : 'contains', value: val });
  }
  if (document.getElementById('f-possession').checked) {
    const op = document.getElementById('f-possession-op').value;
    const val = document.getElementById('f-possession-val').value.trim();
    if (val) conditions.push({ field: 'possession', operator: op, value: val });
  }
  if (document.getElementById('f-name').checked) {
    const val = document.getElementById('f-name-val').value.trim();
    if (val) conditions.push({ field: 'property_name', operator: 'contains', value: val });
  }
  return conditions;
}

function restoreFilterConditions(conditions) {
  ['f-budget','f-config','f-possession','f-name'].forEach(id => document.getElementById(id).checked = false);
  document.querySelectorAll('.f-config-opt').forEach(cb => cb.checked = false);
  document.getElementById('f-config-custom').value = '';
  document.getElementById('f-budget-val').value = '';
  document.getElementById('f-possession-val').value = '';
  document.getElementById('f-name-val').value = '';
  if (!Array.isArray(conditions)) return;
  conditions.forEach(c => {
    if (c.field === 'budget_range') {
      document.getElementById('f-budget').checked = true;
      document.getElementById('f-budget-op').value = c.operator || 'gte';
      document.getElementById('f-budget-val').value = c.value || '';
    }
    if (c.field === 'configuration') {
      document.getElementById('f-config').checked = true;
      const vals = String(c.value).split(',').map(v => v.trim());
      document.querySelectorAll('.f-config-opt').forEach(cb => { if (vals.includes(cb.value)) cb.checked = true; });
      const hasCustom = vals.some(v => !['1BHK','2BHK','3BHK','4BHK'].includes(v));
      if (hasCustom) document.getElementById('f-config-custom').value = c.value;
    }
    if (c.field === 'possession') {
      document.getElementById('f-possession').checked = true;
      document.getElementById('f-possession-op').value = c.operator || 'eq';
      document.getElementById('f-possession-val').value = c.value || '';
    }
    if (c.field === 'property_name') {
      document.getElementById('f-name').checked = true;
      document.getElementById('f-name-val').value = c.value || '';
    }
  });
}

// ── Simulation stubs ──
function openSimulation() { document.getElementById('sim-panel').classList.remove('translate-y-full'); }
function closeSimulation() { document.getElementById('sim-panel').classList.add('translate-y-full'); }

function escapeHtml(text) { const div = document.createElement('div'); div.textContent = text; return div.innerHTML; }
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeModal(); closeSimulation(); } });
</script>  