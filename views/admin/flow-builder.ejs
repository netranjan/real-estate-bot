<!-- ==================== FLOW BUILDER REDESIGN ==================== -->
<style>
  .flow-connector {
    position: absolute;
    left: 16px;
    width: 2px;
    background: #cbd5e1;
    z-index: 0;
  }

  .step-card {
    position: relative;
    transition: all 0.2s ease;
  }

  .step-card:hover {
    transform: translateX(4px);
  }

  .conn-arrow {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #475569;
  }

  .conn-arrow.save_answer {
    background: #ede9fe;
    border-color: #c4b5fd;
    color: #5b21b6;
  }

  .conn-arrow.book_visit {
    background: #dbeafe;
    border-color: #93c5fd;
    color: #1e40af;
  }

  .conn-arrow.request_callback {
    background: #fce7f3;
    border-color: #f9a8d4;
    color: #9d174d;
  }

  .conn-arrow.score_lead {
    background: #fef3c7;
    border-color: #fcd34d;
    color: #92400e;
  }

  [data-tooltip] {
    position: relative;
    cursor: help;
  }

  [data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%);
    background: #1e293b;
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    z-index: 50;
  }

  [data-tooltip]:hover::after {
    opacity: 1;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(0.8);
      opacity: 0.5;
    }

    100% {
      transform: scale(1.3);
      opacity: 0;
    }
  }

  .start-pulse::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #22c55e;
    animation: pulse-ring 2s infinite;
  }
</style>

<div class="space-y-6 max-w-5xl mx-auto">
  <!-- Help Banner -->
  <div class="bg-gradient-to-r from-indigo-50 to-purple-50 border border-indigo-200 rounded-xl p-5">
    <div class="flex items-start gap-4">
      <div class="bg-white rounded-lg p-2 shadow-sm text-2xl">🤖</div>
      <div class="flex-1">
        <h4 class="font-bold text-slate-800 text-sm">Building a conversation flow is like writing a script</h4>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3">
          <div class="bg-white/60 rounded-lg p-3 text-xs text-slate-600"><span class="font-semibold text-indigo-700">1.</span> Add steps top-to-bottom</div>
          <div class="bg-white/60 rounded-lg p-3 text-xs text-slate-600"><span class="font-semibold text-indigo-700">2.</span> Connect "Then what happens?"</div>
          <div class="bg-white/60 rounded-lg p-3 text-xs text-slate-600"><span class="font-semibold text-indigo-700">3.</span> Click 🧪 Test to simulate</div>
        </div>
      </div>
      <button onclick="document.getElementById('help-panel').classList.toggle('hidden')" class="text-xs bg-white border border-indigo-200 hover:bg-indigo-100 text-indigo-700 px-3 py-1.5 rounded-lg font-medium shrink-0">📖 Need help?</button>
    </div>
    <div id="help-panel" class="hidden mt-4 bg-white rounded-lg border border-indigo-100 p-4 text-sm text-slate-600 space-y-3">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="font-semibold text-slate-800 mb-1">💾 Saving Answers</p>
          <p class="text-xs leading-relaxed">When connecting a <b>Question</b> step, choose <b>Save answer</b> and pick a field name. This stores the user's choice in their lead profile (e.g. <code>budget</code>, <code>configuration</code>). You can use <code>{{budget}}</code> later in messages.</p>
        </div>
        <div>
          <p class="font-semibold text-slate-800 mb-1">🔗 Connections</p>
          <p class="text-xs leading-relaxed">Each option needs a "next step". If you don't connect anything, the bot will stop. Use <b>Always</b> for steps that don't need a reply.</p>
        </div>
        <div>
          <p class="font-semibold text-slate-800 mb-1">🔄 Auto-Advance</p>
          <p class="text-xs leading-relaxed"><b>Message</b>, <b>Brochure</b>, and <b>Callback</b> steps automatically go to their default "next step" without waiting.</p>
        </div>
        <div>
          <p class="font-semibold text-slate-800 mb-1">🎯 Smart Property Lists</p>
          <p class="text-xs leading-relaxed">A <b>Show Properties</b> step can display <b>all</b> active projects or a <b>filtered</b> list based on rules. Use filters with <code>{{variables}}</code> to personalize results per lead.</p>
        </div>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-xs text-amber-800">
        <b>⚠️ Common mistake:</b> If a Question step shows the same message repeatedly, check that its connections don't loop back to itself.
      </div>
    </div>
  </div>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h3 class="font-bold text-slate-800 text-xl flex items-center gap-2">
        Conversation Flow
        <% if (activeFlow) { %><span class="text-xs font-normal bg-green-100 text-green-700 px-2 py-0.5 rounded-full">Live</span><% } %>
      </h3>
      <% if (activeFlow) { %>
        <p class="text-sm text-slate-500 mt-1"><%= activeFlow.flow_name %> v<%= activeFlow.flow_version %> • <%= steps.length %> step<%= steps.length !==1 ? 's' : '' %></p>
      <% } else { %>
        <p class="text-sm text-slate-500">No active flow — create one below</p>
      <% } %>
    </div>
    <div class="flex gap-2">
      <% if (flows.length > 1) { %>
        <select onchange="window.location.href='/admin/flows?key=<%= req.query.key || '' %>&clientId=<%= clientId %>&flowId='+this.value" class="px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-purple-500 outline-none shadow-sm">
          <% flows.forEach(f => { %><option value="<%= f.flow_id %>" <%=f.is_active ? 'selected' : '' %>><%= f.flow_name %> <%= f.is_active ? '●' : '' %></option><% }) %>
        </select>
      <% } %>
      <% if (activeFlow) { %>
        <button onclick="openSimulation()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium text-sm shadow-sm flex items-center gap-1.5"><span>🧪</span> Test Flow</button>
        <button onclick="openAddWizard()" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg font-medium text-sm shadow-sm flex items-center gap-1.5"><span>+</span> Add Step</button>
      <% } %>
    </div>
  </div>

  <% if (!activeFlow) { %>
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 text-center">
      <div class="text-4xl mb-3">🔀</div>
      <h4 class="font-bold text-slate-800 text-lg">No conversation flow yet</h4>
      <p class="text-sm text-slate-500 mt-1 mb-4">Create a flow to start building the bot experience.</p>
      <form action="/admin/flows?key=<%= req.query.key || '' %>&clientId=<%= clientId %>" method="POST" class="max-w-md mx-auto flex gap-3">
        <input type="hidden" name="key" value="<%= req.query.key || '' %>">
        <input type="hidden" name="clientId" value="<%= clientId %>">
        <input type="text" name="flow_name" placeholder="Flow name (e.g. Main Sales Flow)" required class="flex-1 px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 outline-none">
        <input type="hidden" name="is_active" value="on">
        <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg text-sm font-medium shadow-sm">Create Flow</button>
      </form>
    </div>
  <% } %>

  <% if (activeFlow) { %>
    <div class="relative pl-10" id="flow-timeline">
      <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-slate-200"></div>
      <div class="relative mb-8">
        <div class="absolute -left-10 top-0 w-8 h-8 rounded-full bg-green-500 border-4 border-white shadow flex items-center justify-center text-xs text-white font-bold start-pulse">S</div>
        <div class="bg-green-50 border border-green-200 rounded-lg px-4 py-2 inline-flex items-center gap-2">
          <span class="text-xs font-semibold text-green-800">START</span>
          <span class="text-xs text-green-600">— User sends first message</span>
        </div>
      </div>
      <div id="sortable-steps" class="space-y-8">
        <% steps.forEach((step, index) => {
          const typeMeta = {
            'collect_input': { icon: '❓', label: 'Question', color: 'purple', desc: 'User picks an option' },
            'send_message': { icon: '📝', label: 'Message', color: 'blue', desc: 'Bot sends text only' },
            'show_list': { icon: '🏠', label: 'Property List', color: 'green', desc: 'Show matching projects' },
            'property_welcome': { icon: '🏢', label: 'Welcome', color: 'orange', desc: 'Project details + actions' },
            'send_document': { icon: '📄', label: 'Brochure', color: 'amber', desc: 'Send PDF file' },
            'book_appointment': { icon: '📅', label: 'Book Visit', color: 'indigo', desc: 'Schedule site visit' },
            'request_callback': { icon: '📞', label: 'Callback', color: 'rose', desc: 'Agent calls back' }
          }[step.node_type] || { icon: '🔹', label: step.node_type, color: 'slate', desc: '' };
          const opts = step.config.options || step.config.buttons || [];
          const hasOptions = opts.length > 0;
          const listMode = step.config.filter_mode || (step.config.mode === 'dynamic_list' ? 'all' : null);
          const isFiltered = listMode === 'filtered';
          const connCount = step.connections ? step.connections.length : 0;
          const needsConnection = step.node_type !== 'request_callback' && step.node_type !== 'send_document';
          const isOrphan = needsConnection && connCount === 0;
        %>
          <div class="relative step-card" data-node-id="<%= step.node_id %>" data-index="<%= index %>" data-filter-mode="<%= step.config.filter_mode || '' %>" data-filter-conditions="<%= encodeURIComponent(JSON.stringify(step.config.filter_conditions || [])) %>">
            <div class="absolute -left-10 top-4 w-8 h-8 rounded-full bg-<%= typeMeta.color %>-500 border-4 border-white shadow flex items-center justify-center text-xs text-white font-bold cursor-move handle z-10"><%= index + 1 %></div>
            <div class="bg-white rounded-xl shadow-sm border <%= isOrphan ? 'border-amber-300 ring-1 ring-amber-100' : 'border-slate-200' %> overflow-hidden hover:shadow-md transition">
              <div class="px-5 py-3 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-lg"><%= typeMeta.icon %></span>
                  <span class="text-xs font-semibold uppercase tracking-wider text-<%= typeMeta.color %>-700 bg-<%= typeMeta.color %>-100 px-2 py-0.5 rounded"><%= typeMeta.label %></span>
                  <span class="text-sm font-medium text-slate-700"><%= step.node_name %></span>
                  <% if (listMode) { %>
                    <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded font-medium"><%= isFiltered ? '🔍 Filtered' : '🏠 All Properties' %></span>
                    <% if (isFiltered && step.config.filter_conditions) { %>
                      <span class="text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded font-medium"><%= step.config.filter_conditions.length %> rule<%= step.config.filter_conditions.length !== 1 ? 's' : '' %></span>
                    <% } %>
                  <% } %>
                  <% if (isOrphan) { %>
                    <span class="text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded font-medium flex items-center gap-1" data-tooltip="This step has no next step. The bot will stop here.">⚠️ Needs Connection</span>
                  <% } %>
                </div>
                <div class="flex gap-1">
                  <button onclick="openEditWizard(<%= step.node_id %>)" class="text-xs bg-white border border-slate-200 hover:bg-slate-100 px-2.5 py-1.5 rounded text-slate-600 font-medium">Edit</button>
                  <form action="/admin/flows/steps/<%= step.node_id %>/delete?key=<%= req.query.key || '' %>&clientId=<%= clientId %>" method="POST" class="inline" onsubmit="return confirm('Delete this step? This will also remove all connections to it.');">
                    <input type="hidden" name="key" value="<%= req.query.key || '' %>">
                    <input type="hidden" name="clientId" value="<%= clientId %>">
                    <button type="submit" class="text-xs bg-white border border-slate-200 hover:bg-red-50 hover:text-red-600 px-2.5 py-1.5 rounded text-slate-400">🗑</button>
                  </form>
                </div>
              </div>
              <div class="p-5">
                <div class="flex justify-start">
                  <div class="bg-slate-100 rounded-2xl rounded-tl-sm px-4 py-3 max-w-lg">
                    <p class="text-sm text-slate-800 whitespace-pre-wrap"><%= step.config.text || '(No message)' %></p>
                  </div>
                </div>
                <% if (hasOptions) { %>
                  <div class="flex flex-wrap gap-2 mt-3 ml-2">
                    <% opts.forEach(opt => { %>
                      <span class="px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-700 shadow-sm font-medium"><%= opt.label || opt.title || opt %></span>
                    <% }) %>
                  </div>
                <% } %>
                <% if (listMode) { %>
                  <div class="mt-3 p-2 bg-green-50 border border-green-200 rounded-lg text-xs text-green-700 flex items-center gap-2">
                    <span>📋</span><span><%= isFiltered ? `Filtered list: ${step.config.filter_conditions.length} rule(s) applied` : 'Will show all active properties from database as a WhatsApp list' %></span>
                  </div>
                <% } %>
                <div class="mt-4 pt-4 border-t border-slate-100">
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Then what happens?</p>
                      <% if (connCount > 0) { %>
                        <span class="text-xs bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-medium"><%= connCount %> connection<%= connCount !==1 ? 's' : '' %></span>
                      <% } %>
                    </div>
                    <button onclick="toggleQuickConnect(<%= step.node_id %>)" class="text-xs bg-purple-50 hover:bg-purple-100 text-purple-700 px-3 py-1.5 rounded-lg font-medium border border-purple-200 transition">+ Connect Next Step</button>
                  </div>
                  <% if (step.connections && step.connections.length > 0) { %>
                    <div class="space-y-2">
                      <% step.connections.forEach(conn => {
                        const action = conn.conditionLogic || {};
                        let actionClass = ''; let actionIcon = '→'; let actionText = '';
                        if (action.action === 'save_answer') { actionClass = 'save_answer'; actionIcon = '💾'; actionText = 'Save to ' + (action.field || 'field'); }
                        else if (action.action === 'book_visit') { actionClass = 'book_visit'; actionIcon = '📅'; actionText = 'Book visit'; }
                        else if (action.action === 'request_callback') { actionClass = 'request_callback'; actionIcon = '📞'; actionText = 'Request callback'; }
                        else if (action.action === 'score_lead') { actionClass = 'score_lead'; actionIcon = '⭐'; actionText = 'Score lead'; }
                      %>
                        <div class="flex items-center gap-2 text-sm group bg-white rounded-lg border border-slate-100 p-2 hover:border-slate-200 transition">
                          <% if (conn.userInput) { %>
                            <span class="px-2 py-0.5 bg-purple-50 border border-purple-100 rounded text-purple-700 text-xs font-medium">"<%= conn.userInput %>"</span>
                          <% } else { %>
                            <span class="px-2 py-0.5 bg-slate-50 border border-slate-100 rounded text-slate-500 text-xs font-medium">Always</span>
                          <% } %>
                          <% if (actionText) { %><span class="conn-arrow <%= actionClass %>"><%= actionIcon %> <%= actionText %></span><% } %>
                          <span class="text-slate-400">→</span>
                          <span class="font-medium text-slate-700"><%= conn.toNodeName %></span>
                          <form action="/admin/flows/connections/<%= conn.edgeId %>/delete?key=<%= req.query.key || '' %>&clientId=<%= clientId %>" method="POST" class="inline opacity-0 group-hover:opacity-100 transition ml-auto">
                            <input type="hidden" name="key" value="<%= req.query.key || '' %>">
                            <input type="hidden" name="clientId" value="<%= clientId %>">
                            <button type="submit" class="text-xs text-red-400 hover:text-red-600 px-1">✕ Remove</button>
                          </form>
                        </div>
                      <% }) %>
                    </div>
                  <% } else if (needsConnection) { %>
                    <div class="bg-amber-50 border border-amber-200 rounded-lg px-3 py-2.5 flex items-start gap-2">
                      <span class="text-amber-500 text-sm">⚠️</span>
                      <div>
                        <p class="text-xs text-amber-700 font-medium">No next step connected</p>
                        <p class="text-xs text-amber-600 mt-0.5">The bot will stop here. Click "+ Connect Next Step" to continue the conversation.</p>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="bg-slate-50 rounded-lg px-3 py-2 flex items-center gap-2">
                      <span class="text-slate-400 text-xs">🏁</span>
                      <p class="text-xs text-slate-500">End of flow — no next step needed</p>
                    </div>
                  <% } %>

                  <!-- Quick Connect Form -->
                  <form id="qc-<%= step.node_id %>" action="/admin/flows/connections?key=<%= req.query.key || '' %>&clientId=<%= clientId %>" method="POST" class="hidden mt-3 p-4 bg-slate-50 rounded-lg border border-slate-200 space-y-3">
                    <input type="hidden" name="key" value="<%= req.query.key || '' %>">
                    <input type="hidden" name="clientId" value="<%= clientId %>">
                    <input type="hidden" name="from_step" value="<%= step.node_id %>">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-semibold text-slate-700">Create Connection</span>
                      <span class="text-xs text-slate-400">— Define what happens when the user responds</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">When user picks...</label>
                        <% if (hasOptions) { %>
                          <select name="user_choice" class="w-full px-2 py-1.5 border border-slate-300 rounded text-xs bg-white focus:ring-2 focus:ring-purple-500 outline-none">
                            <option value="">Any option (default)</option>
                            <% opts.forEach(opt => { %>
                              <option value="<%= opt.value || opt.id || opt.label || opt.title || opt %>"><%= opt.label || opt.title || opt %></option>
                            <% }) %>
                          </select>
                        <% } else { %>
                          <input type="hidden" name="user_choice" value="">
                          <div class="px-2 py-1.5 bg-white border border-slate-200 rounded text-xs text-slate-500">Always (this step doesn't wait for a choice)</div>
                        <% } %>
                      </div>
                      <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Also do this action...</label>
                        <select name="action_type" class="w-full px-2 py-1.5 border border-slate-300 rounded text-xs bg-white focus:ring-2 focus:ring-purple-500 outline-none" onchange="toggleActionField(this, <%= step.node_id %>)">
                          <option value="none">Just go to next step</option>
                          <option value="save_answer">💾 Save user's answer</option>
                          <option value="select_property">🏠 Remember selected property</option>
                          <option value="book_visit">📅 Book site visit</option>
                          <option value="request_callback">📞 Request callback</option>
                          <option value="score_lead">⭐ Score lead</option>
                        </select>
                      </div>
                    </div>
                    <div id="af-box-<%= step.node_id %>" class="hidden">
                      <label class="block text-xs font-medium text-slate-600 mb-1">Save answer into which field?</label>
                      <div class="flex gap-2">
                        <select id="af-select-<%= step.node_id %>" onchange="onFieldSelectChange(this, <%= step.node_id %>)" class="px-2 py-1.5 border border-slate-300 rounded text-xs bg-white focus:ring-2 focus:ring-purple-500 outline-none flex-1">
                          <option value="">Choose a field...</option>
                          <optgroup label="Common Lead Fields">
                            <option value="budget">💰 budget — How much they want to spend</option>
                            <option value="configuration">🏠 configuration — 2BHK, 3BHK, etc.</option>
                            <option value="requirement_type">🎯 requirement_type — Self-use or Investment</option>
                            <option value="timeline">📅 timeline — When they plan to buy</option>
                            <option value="location">📍 location — Preferred area/city</option>
                            <option value="possession">🔑 possession — Ready or under construction</option>
                            <option value="visit_date">📅 visit_date — When they want to visit</option>
                          </optgroup>
                          <optgroup label="Other">
                            <option value="__custom__">✏️ Custom field name...</option>
                          </optgroup>
                        </select>
                        <input type="text" name="action_field" id="af-<%= step.node_id %>" placeholder="e.g. custom_field" class="hidden px-2 py-1.5 border border-slate-300 rounded text-xs flex-1">
                      </div>
                      <p class="text-xs text-slate-400 mt-1">This name is used to store the answer. You can reuse it later as <code class="bg-slate-100 px-1 rounded">{{field_name}}</code> in messages.</p>
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-slate-600 mb-1">Then go to this step <span class="text-red-500">*</span></label>
                      <select name="to_step" required class="w-full px-2 py-1.5 border border-slate-300 rounded text-xs bg-white focus:ring-2 focus:ring-purple-500 outline-none">
                        <option value="">Pick next step...</option>
                        <% steps.forEach(s => { if (s.node_id !== step.node_id) { %>
                          <option value="<%= s.node_id %>"><%= steps.indexOf(s) + 1 %>. <%= s.node_name %> (<%= s.node_type %>)</option>
                        <% } }) %>
                      </select>
                    </div>
                    <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
                      <button type="button" onclick="toggleQuickConnect(<%= step.node_id %>)" class="px-3 py-1.5 text-xs text-slate-500 hover:bg-slate-100 rounded">Cancel</button>
                      <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white px-4 py-1.5 rounded text-xs font-medium">Create Connection</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <div class="relative mt-8">
        <div class="absolute -left-10 top-3 w-8 h-8 rounded-full bg-slate-200 border-4 border-white shadow flex items-center justify-center text-xs text-slate-500 font-bold">+</div>
        <button onclick="openAddWizard()" class="w-full py-4 border-2 border-dashed border-slate-300 rounded-xl text-slate-500 hover:border-purple-400 hover:text-purple-600 hover:bg-purple-50 transition font-medium text-sm flex items-center justify-center gap-2">
          <span class="text-lg">+</span> Add a new step
        </button>
      </div>
    </div>
  <% } %>
</div>

<!-- Modal -->
<div id="step-modal" class="fixed inset-0 bg-black/50 hidden z-50 flex justify-end">
  <div class="bg-white w-full max-w-3xl h-full overflow-auto shadow-2xl flex flex-col">
    <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
      <div class="flex items-center gap-3">
        <h3 class="font-bold text-slate-800 text-lg" id="modal-title">Add Step</h3>
        <button onclick="toggleMode()" id="mode-toggle" class="text-xs bg-white border border-slate-300 px-2 py-1 rounded hover:bg-slate-100 text-slate-600">Switch to Direct Editor</button>
      </div>
      <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-xl leading-none">&times;</button>
    </div>

    <!-- Wizard Mode -->
    <div id="wizard-mode" class="flex-1 p-6 space-y-6">
      <div id="wz-step-1">
        <label class="block text-sm font-semibold text-slate-700 mb-3">1. What should this step do? <span class="text-slate-400 font-normal">Pick one</span></label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <% const wzTypes = [
            { code: 'question', icon: '❓', title: 'Ask Question', desc: 'Show buttons and wait for user to pick', example: 'What is your budget?' },
            { code: 'message', icon: '📝', title: 'Send Message', desc: 'Just send text, no reply needed', example: 'Thanks for your interest!' },
            { code: 'property_list', icon: '🏠', title: 'Show Properties', desc: 'Display projects from database', example: 'Here are matching projects:' },
            { code: 'property_welcome', icon: '🏢', title: 'Project Welcome', desc: 'Show project details + action buttons', example: 'Welcome to Godrej Park!' },
            { code: 'brochure', icon: '📄', title: 'Send Brochure', desc: 'Send a PDF document', example: 'Here is the brochure.' },
            { code: 'book_visit', icon: '📅', title: 'Book Visit', desc: 'Schedule a site visit', example: 'Pick a date for your visit.' },
            { code: 'callback', icon: '📞', title: 'Request Callback', desc: 'Agent calls back', example: 'Our agent will call you.' }
          ]; %>
          <% wzTypes.forEach(t => { %>
            <div onclick="wzSelectType('<%= t.code %>')" data-wz-type="<%= t.code %>" class="wz-type-card cursor-pointer border-2 border-slate-200 rounded-xl p-4 hover:border-purple-400 hover:bg-purple-50 transition text-center group">
              <div class="text-2xl mb-2 group-hover:scale-110 transition-transform"><%= t.icon %></div>
              <p class="text-sm font-semibold text-slate-800"><%= t.title %></p>
              <p class="text-xs text-slate-500 mt-1 leading-tight"><%= t.desc %></p>
              <p class="text-[10px] text-purple-600 mt-2 font-medium opacity-0 group-hover:opacity-100 transition-opacity">Ex: "<%= t.example %>"</p>
            </div>
          <% }) %>
        </div>
        <div class="flex justify-end mt-4">
          <button onclick="wzGoTo(2)" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg text-sm font-medium shadow-sm">Next →</button>
        </div>
      </div>

      <div id="wz-step-2" class="hidden space-y-4">
        <div class="flex items-center justify-between">
          <label class="block text-sm font-semibold text-slate-700">2. What should the bot say?</label>
          <span class="text-xs text-slate-400 bg-slate-100 px-2 py-1 rounded" id="wz-type-hint">Ask a question with button options</span>
        </div>
        <textarea id="wz-message" rows="3" placeholder="Type the message here..." class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-purple-500 outline-none text-sm"></textarea>
        <div class="bg-[#e5ddd5] rounded-2xl p-4 max-w-sm mx-auto border border-slate-200">
          <div class="bg-white rounded-lg rounded-tl-none px-3 py-2 shadow-sm max-w-[85%]">
            <p class="text-sm text-slate-800" id="wz-preview-msg">Type above to see preview...</p>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-2 max-w-[85%]" id="wz-preview-opts"></div>
        </div>
        <div id="wz-options-box">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Button options <span class="text-slate-400 font-normal">(one per line, max 3 for buttons)</span></label>
          <textarea id="wz-options" rows="3" placeholder="Buy for Self-Use&#10;Investment / Rent" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-purple-500 outline-none text-sm font-mono"></textarea>
          <p class="text-xs text-slate-400 mt-1">Each line becomes a button in WhatsApp. The user taps one to continue.</p>
        </div>
        <!-- Property List Mode Selector -->
        <div id="wz-list-mode-box" class="hidden space-y-4">
          <label class="block text-sm font-semibold text-slate-700">Which properties should the bot show?</label>
          <div class="space-y-3">
            <!-- Option 1: Show All -->
            <div onclick="document.getElementById('wz-mode-all').checked=true; toggleFilterBuilder()" class="cursor-pointer border-2 border-slate-200 rounded-xl p-4 hover:border-green-400 hover:bg-green-50 transition flex items-start gap-3">
              <input type="radio" name="wz-list-mode" id="wz-mode-all" value="all" checked class="mt-1 w-4 h-4 text-green-600" onclick="event.stopPropagation(); toggleFilterBuilder()">
              <div>
                <p class="text-sm font-semibold text-slate-800">🏠 Show ALL active properties</p>
                <p class="text-xs text-slate-500 mt-0.5">Displays every property listed for this client. Best for fresh leads or when you want to show everything.</p>
              </div>
            </div>
            <!-- Option 2: Show Filtered -->
            <div onclick="document.getElementById('wz-mode-filtered').checked=true; toggleFilterBuilder()" class="cursor-pointer border-2 border-slate-200 rounded-xl p-4 hover:border-purple-400 hover:bg-purple-50 transition flex items-start gap-3">
              <input type="radio" name="wz-list-mode" id="wz-mode-filtered" value="filtered" class="mt-1 w-4 h-4 text-purple-600" onclick="event.stopPropagation(); toggleFilterBuilder()">
              <div class="flex-1">
                <p class="text-sm font-semibold text-slate-800">🔍 Show FILTERED properties</p>
                <p class="text-xs text-slate-500 mt-0.5">Only show properties that match rules you define below. The bot checks the lead's saved answers automatically.</p>
                <!-- Simple Filter Builder -->
                <div id="wz-filter-builder" class="hidden mt-4 space-y-3">
                  <p class="text-xs font-semibold text-slate-600">Check the rules you want to apply:</p>
                  <!-- Budget -->
                  <div class="filter-block bg-white border border-slate-200 rounded-lg p-3">
                    <label class="flex items-center gap-2 cursor-pointer">
                      <input type="checkbox" id="f-budget" class="w-4 h-4 text-purple-600 rounded">
                      <span class="text-sm font-medium text-slate-700">💰 Budget</span>
                    </label>
                    <div class="mt-2 ml-6 grid grid-cols-2 gap-2">
                      <select id="f-budget-op" class="px-2 py-1.5 border border-slate-300 rounded text-xs bg-white">
                        <option value="gte">At least ₹</option>
                        <option value="lte">At most ₹</option>
                        <option value="between">Between ₹</option>
                      </select>
                      <input type="text" id="f-budget-val" placeholder="1500000 or {{budget}}" class="px-2 py-1.5 border border-slate-300 rounded text-xs">
                    </div>
