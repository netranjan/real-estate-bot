<div class="space-y-6 fade-in">
  <!-- Header (unchanged) -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <div class="flex justify-between items-start flex-wrap gap-4">
      <div>
        <h2 class="text-2xl font-bold text-slate-800"><%= property.property_name %></h2>
        <p class="text-sm text-slate-500">Property ID: <span class="font-mono text-xs"><%= property.property_id %></span></p>
      </div>
      <div class="flex gap-2">
        <a href="/admin/properties/<%= property.property_id %>/slots?clientId=<%= clientId %>" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-medium">🕒 Manage Slots</a>
        <a href="/admin/properties?clientId=<%= clientId %>" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm">← Back to Properties</a>
      </div>
    </div>
  </div>

  <!-- Property Details -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h3 class="text-lg font-semibold text-slate-800 mb-4">Details</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <p class="text-xs text-slate-500 uppercase font-semibold">Price Range</p>
        <p class="text-sm text-slate-700 mt-1">
          <% if (property.price_min) { %>
            <%= formatPrice(property.price_min, currencySymbol) %>
            <% if (property.price_max && property.price_max !== property.price_min) { %>
              - <%= formatPrice(property.price_max, currencySymbol) %>
            <% } %>
          <% } else { %> Not set <% } %>
        </p>
      </div>
      <div>
        <p class="text-xs text-slate-500 uppercase font-semibold">Configurations</p>
        <p class="text-sm text-slate-700 mt-1"><%= property.configuration_types ? property.configuration_types.join(', ') : 'Not specified' %></p>
      </div>
      <div>
        <p class="text-xs text-slate-500 uppercase font-semibold">Possession Date</p>
        <p class="text-sm text-slate-700 mt-1"><%= property.possession_date ? new Date(property.possession_date).toLocaleDateString('en-IN') : 'Not set' %></p>
      </div>
      <div>
        <p class="text-xs text-slate-500 uppercase font-semibold">Referral Code</p>
        <p class="font-mono text-sm text-slate-700 mt-1"><%= property.referral_code || 'Not set' %></p>
      </div>
      <div>
        <p class="text-xs text-slate-500 uppercase font-semibold">Google Maps</p>
        <p class="text-sm text-slate-700 mt-1">
          <% if (property.google_map_url) { %>
            <a href="<%= property.google_map_url %>" target="_blank" class="text-blue-600 hover:underline">View on Map</a>
          <% } else { %> Not set <% } %>
        </p>
      </div>
      <div>
        <p class="text-xs text-slate-500 uppercase font-semibold">Active</p>
        <p class="text-sm text-slate-700 mt-1">
          <% if (property.active) { %>
            <span class="px-2 py-0.5 bg-green-100 text-green-700 text-xs rounded font-semibold">Active</span>
          <% } else { %>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-500 text-xs rounded font-semibold">Inactive</span>
          <% } %>
        </p>
      </div>
    </div>
  </div>

  <!-- Assets Section -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h3 class="text-lg font-semibold text-slate-800 mb-4">Media Assets</h3>
    <% if (assets && assets.length > 0) { %>
      <div class="space-y-3">
        <% assets.forEach(asset => { %>
          <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg border border-slate-200">
            <div class="flex items-center gap-3">
              <span class="text-xl">
                <%= asset.asset_type === 'image' ? '🖼️' : 
                    asset.asset_type === 'video' ? '🎥' : 
                    asset.asset_type === 'pdf' ? '📕' :
                    asset.asset_type === 'brochure' ? '📄' : '📎' %>
              </span>
              <div>
                <p class="text-sm font-medium text-slate-800"><%= asset.asset_name || asset.asset_url %></p>
                <p class="text-xs text-slate-500">
                  Type: <%= asset.asset_type %> | 
                  <% if (asset.asset_url) { %>
                    <a href="<%= asset.asset_url %>" target="_blank" class="text-blue-600 hover:underline">Open</a>
                  <% } else { %> No URL <% } %>
                </p>
              </div>
            </div>
            <span class="text-xs text-slate-400"><%= asset.created_at ? new Date(asset.created_at).toLocaleDateString('en-IN') : '' %></span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-sm text-slate-400">No media assets attached.</p>
    <% } %>
  </div>

  <!-- Welcome Message (unchanged) -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h3 class="text-lg font-semibold text-slate-800 mb-2">Welcome Message</h3>
    <p class="text-sm text-slate-600 whitespace-pre-wrap"><%= property.welcome_message || 'Not set' %></p>
  </div>

  <!-- Slots Summary (unchanged) -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h3 class="text-lg font-semibold text-slate-800 mb-4">Visit Slots</h3>
    <% if (slots && slots.length) { %>
      <div class="flex flex-wrap gap-2">
        <% slots.forEach(slot => { %>
          <span class="px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-xs font-medium"><%= slot.option_name %></span>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-sm text-slate-400">No slots defined. <a href="/admin/properties/<%= property.property_id %>/slots?clientId=<%= clientId %>" class="text-purple-600 hover:underline">Add some</a>.</p>
    <% } %>
  </div>
</div>